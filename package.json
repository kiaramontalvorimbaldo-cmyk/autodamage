{
  "name": "autodamage-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:coverage": "vitest run --configLoader runner --coverage",
    "test:e2e": "playwright test",
    "test:ci": "node scripts/ci/run.mjs unit",
    "test:e2e:ci": "node scripts/ci/run.mjs e2e",
    "build:ci": "node scripts/ci/run.mjs build",
    "format": "prettier --write .",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "preflight": "node scripts/verificar-entorno.mjs",
    "seed:users:plan": "tsx scripts/seed-dev-users.ts --plan",
    "seed:users:apply": "tsx scripts/seed-dev-users.ts --apply"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,mdx,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
