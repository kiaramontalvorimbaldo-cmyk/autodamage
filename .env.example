# Copiar a .env.local. No incluir claves reales en Git.
# local:setup y local:dev generan la conexión PostgreSQL y el almacenamiento privado.
AI_PROVIDER=mock
MOCK_AI_SCENARIO=leve-faro
GEMINI_API_KEY=
GEMINI_MODEL=
DAILY_AI_QUOTA_LIMIT=200
AI_MAX_RPM=10

# Opcional: ruta de binarios si PostgreSQL no está en la ubicación predeterminada.
POSTGRES_BIN=
# Solo se usa al crear por primera vez las cuentas demo.
DEMO_PASSWORD=

# Compatibilidad durante la transición: solo para el modo anterior o exportar datos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
VERCEL_TOKEN=
DEV_ASEGURADO_PASSWORD=
DEV_PERITO_PASSWORD=
DEV_TALLER_1_PASSWORD=
DEV_TALLER_2_PASSWORD=
DEV_ADMIN_PASSWORD=
